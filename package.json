{
  "name": "@knowark/modelarkjs",
  "version": "0.22.4",
  "description": "Models Definition and Application Data Access Library",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' npx jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowark/modelarkjs.git"
  },
  "keywords": [
    "model",
    "database",
    "in-memory",
    "postgresql",
    "json"
  ],
  "author": "Knowark",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/knowark/modelarkjs/issues"
  },
  "jest": {
    "transform": {},
    "collectCoverageFrom": [
      "lib/**/*.js",
      "!lib/**/*.test.js",
      "!lib/**/fixtures/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "standard": {
    "ignore": [
      "*.d.ts"
    ]
  },
  "homepage": "https://github.com/knowark/modelarkjs#readme",
  "devDependencies": {
    "jest": "^29.5.0",
    "standard": "next"
  }
}
